load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "raftdemo",
    srcs = [
        "cluster.go",
        "config.go",
        "doc.go",
        "message.go",
        "node.go",
        "observer.go",
        "state.go",
        "transitions.go",
    ],
    importpath = "github.com/candacelabs/csf/examples/widget/raftdemo",
    visibility = ["//visibility:public"],
