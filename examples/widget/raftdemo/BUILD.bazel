go_test(
    name = "raftdemo_test",
    srcs = [
        "cluster_test.go",
        "raftdemo_suite_test.go",
        "transitions_test.go",
    ],
    embed = [":raftdemo"],
    deps = [
        "@com_github_onsi_ginkgo_v2//:ginkgo",
        "@com_github_onsi_gomega//:gomega",
    ],
)
