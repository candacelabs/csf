load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dashboard",
    srcs = [
        "dashboard.go",
        "helpers.go",
    ],
    embedsrcs = [
        "assets/htmx.min.js",
        "assets/warden.css",
        "templates/cluster_partial.html",
        "templates/index.html",
    ],
    importpath = "github.com/candacelabs/csf/services/warden/dashboard",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/core",
        "//services/warden",
        "@com_github_gin_gonic_gin//:gin",
