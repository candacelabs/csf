go_test(
    name = "dashboard_test",
    srcs = [
        "dashboard_contract_test.go",
        "dashboard_test.go",
        "helpers_test.go",
    ],
    embed = [":dashboard"],
    deps = [
        "//services/warden",
        "//services/warden/httpserver",
        "//services/warden/internal/mocks",
        "@com_github_onsi_ginkgo_v2//:ginkgo",
        "@com_github_onsi_gomega//:gomega",
        "@org_uber_go_mock//gomock",
    ],
)
