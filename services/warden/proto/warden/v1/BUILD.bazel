load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "warden",
    srcs = [
        "gen.go",
        "warden.pb.go",
        "warden_grpc.pb.go",
    ],
    importpath = "github.com/candacelabs/csf/services/warden/proto/warden/v1",
    visibility = ["//visibility:public"],
    deps = [
        "@org_golang_google_grpc//:grpc",
