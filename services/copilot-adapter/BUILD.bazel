load("@rules_go//go:def.bzl", "go_library", "go_test")

# The host composition test consumes the same trace defaults as this service.
exports_files(
    ["config/traces.defaults.json"],
    visibility = ["//app/csf/cmd:__pkg__"],
)

go_library(
    name = "copilot-adapter",
    srcs = [
        "config.go",
        "handlers.go",
        "options.go",
        "restoration.go",
        "schedules.go",
        "seams.go",
        "service.go",
        "session_mutations.go",
        "sessions.go",
        "sse.go",
        "subagent_handlers.go",
        "telemetry.go",
        "terminal_handlers.go",
        "traces.go",
        "views.go",
        "views_gen.go",
        "views_seam.go",
        "workspace.go",
        "workspace_changes.go",
        "workspace_tasks.go",
        "worktree_handlers.go",
    ],
    embedsrcs = ["config/defaults.json"],
    importpath = "github.com/candacelabs/csf/services/copilot-adapter",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/cron",
        "//pkg/httpserver",
        "//pkg/workcontinuity",
        "//proto/candace/work/v1:work",
        "//services/copilot-adapter/gen/api",
        "//services/copilot-adapter/proto/candace/copilot/v1:copilot",
        "//services/copilot-adapter/storedb",
        "@com_github_getkin_kin_openapi//openapi3filter",
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_google_uuid//:uuid",
        "@com_github_guregu_null_v5//:null",
        "@io_opentelemetry_go_otel_exporters_otlp_otlptrace//:otlptrace",
        "@io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracehttp//:otlptracehttp",
        "@io_opentelemetry_go_proto_otlp//common/v1:common",
        "@io_opentelemetry_go_proto_otlp//resource/v1:resource",
        "@io_opentelemetry_go_proto_otlp//trace/v1:trace",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "copilot-adapter_test",
    srcs = [
        "config_test.go",
        "copilotadapter_suite_test.go",
        "helpers_test.go",
        "mock_seams_generate_test.go",
        "mock_seams_test.go",
        "mock_trace_client_test.go",
        "schedules_test.go",
        "service_test.go",
        "sse_test.go",
        "traces_test.go",
        "views_test.go",
    ],
    # Trace tests read this owned fixture rather than duplicating its values.
    data = ["config/traces.defaults.json"],  # keep
    embed = [":copilot-adapter"],
    deps = [
        "//pkg/cron",
        "//pkg/httpserver",
        "//pkg/patience",
        "//services/copilot-adapter/gen/api",
        "//services/copilot-adapter/proto/candace/copilot/v1:copilot",
        "//services/copilot-adapter/storedb",
        "@com_github_google_uuid//:uuid",
        "@com_github_guregu_null_v5//:null",
        "@com_github_onsi_ginkgo_v2//:ginkgo",
        "@com_github_onsi_gomega//:gomega",
        "@com_github_onsi_gomega//gstruct",
        "@io_opentelemetry_go_proto_otlp//trace/v1:trace",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_uber_go_mock//gomock",
    ],
)
