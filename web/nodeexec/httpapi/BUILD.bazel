load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "httpapi",
    srcs = [
        "api.go",
        "wire.go",
    ],
    importpath = "github.com/candacelabs/csf/web/nodeexec/httpapi",
    visibility = ["//visibility:public"],
    deps = [
        "//proto/candace/deploy/v1:deploy",
        "//services/nodeexec",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "httpapi_test",
    srcs = [
        "api_test.go",
        "launcher_support_test.go",
    ],
    deps = [
        ":httpapi",
        "//io/ipc/proc",
        "//proto/candace/deploy/v1:deploy",
        "//services/deploy",
        "//services/nodeexec",
        "@com_github_onsi_ginkgo_v2//:ginkgo",
        "@com_github_onsi_gomega//:gomega",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)
