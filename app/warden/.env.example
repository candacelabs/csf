# warden environment configuration — EXAMPLE. Copy to `.env` (for docker
# compose, at the repo root) or to `/etc/warden/warden.env` (for systemd) and
# fill in real values. NEVER commit a filled-in copy: it may hold the SMTP
# app password. Env vars override any value in warden.yaml.
#
# A usable deployment needs at least a node identity (WARDEN_NODE_ID) that
# matches an entry in the peer set, and a peer set: warden compiles in neither
# a fleet nor a notification recipient, so WARDEN_PEERS or a WARDEN_CONFIG file
# must supply the member set or startup fails validation.

# ---- identity & networking ----------------------------------------------
# This node's id. Must match one of the ids in the peer set. REQUIRED in
# practice (defaults + peer list alone don't know which node this is).
WARDEN_NODE_ID=node-c

# HTTP listen address. Default ":7717".
WARDEN_BIND=:7717

# Durable election-state directory (holds state.json). Default "/var/lib/warden".
WARDEN_DATA_DIR=/var/lib/warden

# Full fleet member SEED as id=host:port pairs, comma-separated. Overrides the
# `peers:` in the YAML config. warden compiles in no fleet at all, so either
# this variable or a WARDEN_CONFIG file must supply the member set.
# WARDEN_PEERS=node-a=203.0.113.11:7717,node-b=203.0.113.12:7717,node-c=203.0.113.13:7717,node-d=203.0.113.14:7717

# This node's routable ip:port. Only needed when this node is a discovery-mode
# JOINER whose WARDEN_NODE_ID is NOT yet in the peer seed (a brand-new node runs
# as an observer until the leader admits it). Empty => WARDEN_BIND is used, so a
# joiner must set a real host here (not 0.0.0.0/:port).
# WARDEN_ADVERTISE_ADDR=203.0.113.12:7717

# Optional path to a YAML config file (read before env overrides).
# WARDEN_CONFIG=/etc/warden/warden.yaml

# ---- logging -------------------------------------------------------------
# Level: debug | info | warn | error. Default "info".
WARDEN_LOG_LEVEL=info
# Format: set to "console" for human-readable logs. Anything else (or unset)
# => structured JSON on stdout (the production default).
# WARDEN_LOG_FORMAT=console

# ---- timing (Go duration strings) ---------------------------------------
# Invariants: heartbeat < suspect < dead; election_min < election_max; all > 0.
# WARDEN_HEARTBEAT_INTERVAL=1s
# WARDEN_SUSPECT_AFTER=5s
# WARDEN_DEAD_AFTER=15s
# WARDEN_ELECTION_TIMEOUT_MIN=1500ms
# WARDEN_ELECTION_TIMEOUT_MAX=3s
# WARDEN_RPC_TIMEOUT=500ms

# ---- watchdog ------------------------------------------------------------
# Minimum gap between repeat notifications for the same peer. Default 10m.
# WARDEN_COOLDOWN=10m
# Notify when a dead peer recovers. true|false. Default true.
# WARDEN_NOTIFY_RECOVERY=true

# ---- discovery (membership autodiscovery) --------------------------------
# Advisory only: discovery never changes the quorum denominator (quorum is
# always over the persisted voter set). The peer seed above is always required.
# Left commented so an UNEDITED copy fails safe to mode=static (peers only).
# Mode: static | tailscale | file. Default static.
# WARDEN_DISCOVERY_MODE=static
# Cluster identity for the identify handshake. Default candacenet.
# WARDEN_CLUSTER_ID=candacenet
# How long a verified observer must stay present before the leader admits it.
# WARDEN_JOIN_STABILITY=30s
# How long a voter may be absent before the leader removes it. 0 = never.
# WARDEN_REMOVE_AFTER=0s
# --- mode=file: poll a JSON roster file ({"nodes":[{"id","addr"}...]}). Doubles
#     as a manual dynamic mode (edit the file; warden picks it up). ---
# WARDEN_DISCOVERY_FILE=/var/lib/warden/roster.json
# WARDEN_FILE_POLL_INTERVAL=2s
# --- mode=tailscale: poll the local tailscaled LocalAPI. Select peers by ACL
#     tag and/or an anchored RE2 hostname pattern (either matches). ---
# WARDEN_TS_SOCKET=/var/run/tailscale/tailscaled.sock
# WARDEN_TS_TAG=tag:candacenet
# WARDEN_TS_HOST_PATTERN=warden-.*
# WARDEN_TS_POLL_INTERVAL=15s

# ---- notifications -------------------------------------------------------
# Mode: smtp | log | file. Default: smtp if SMTP_HOST is set, else log.
# Left commented so an UNEDITED copy of this file fails safe (mode=log, no
# email attempts with placeholder credentials). Uncomment once SMTP is real.
# WARDEN_NOTIFY_MODE=smtp
# For mode=file, the incident sink path:
# WARDEN_NOTIFY_FILE=/var/log/warden/incidents.jsonl

# --- SMTP (mode=smtp). Gmail example. ---
# Gmail requires an APP PASSWORD (Google Account -> Security -> App passwords),
# NOT your normal account password, and 2FA must be enabled.
# SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=warden@example.invalid
SMTP_FROM=warden@example.invalid
# Comma-separated recipient list. Required for mode=smtp; there is no default.
SMTP_TO=ops@example.invalid
# The app password. PLACEHOLDER ONLY — replace with a real app password and
# keep this file out of git. Leave empty for IP-allowlisted relays.
# SMTP_PASS=changeme
