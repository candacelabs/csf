[Unit]
Description=candace/csf Langfuse worker
After=network-online.target candace-csf-langfuse-migrate.service
Requires=candace-csf-langfuse-migrate.service

[Service]
Type=simple
DynamicUser=yes
Environment=NODE_ENV=production
Environment=PORT=13030
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/etc/candace/csf/langfuse.env
WorkingDirectory=/opt/candace/csf/components/langfuse
ExecStart=/opt/candace/csf/components/langfuse/bin/node worker/dist/index.js
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
