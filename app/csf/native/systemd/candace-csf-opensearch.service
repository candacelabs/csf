[Unit]
Description=candace/csf OpenSearch 3.8
After=network.target

[Service]
Type=simple
User=candace-csf-opensearch
Group=candace-csf-opensearch
StateDirectory=candace-csf-opensearch
LogsDirectory=candace-csf-opensearch
StateDirectoryMode=0700
ConfigurationDirectory=candace/csf/opensearch
Environment=OPENSEARCH_PATH_CONF=/etc/candace/csf/opensearch
EnvironmentFile=/etc/candace/csf/opensearch.env
# opensearch.yml is root:candace-csf-opensearch 0640.
ExecStart=/opt/candace/csf/components/opensearch/bin/opensearch
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
