NEXTAUTH_URL=http://127.0.0.1:13000
NEXTAUTH_SECRET=CHANGE_ME
DATABASE_URL=postgresql://langfuse:CHANGE_ME@127.0.0.1:15432/langfuse
DIRECT_URL=postgresql://langfuse:CHANGE_ME@127.0.0.1:15432/langfuse
SALT=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
CLICKHOUSE_MIGRATION_URL=clickhouse://127.0.0.1:19090
CLICKHOUSE_URL=http://127.0.0.1:18123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGE_ME
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_AUTH=CHANGE_ME
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=CHANGE_ME
LANGFUSE_S3_EVENT_UPLOAD_REGION=us-east-1
# Set both Langfuse-specific keys to use a static pair for this storage.
# LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=
# LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=false
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=CHANGE_ME
LANGFUSE_S3_MEDIA_UPLOAD_REGION=us-east-1
# LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=
# LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=false
# Alternatively, set a service-scoped AWS static pair for both S3 uses. A
# session token is accepted only with this pair. When unset, preflight uses the
# EC2 instance role; it does not read the invoking user's AWS profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
