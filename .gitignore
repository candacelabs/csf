# Bazel's convenience symlinks, created in the workspace root on every build.
/bazel-*
# Standalone Rust operator build output.
tools/csf-operator/target/
# House lint and ontology score output, written into the scanned checkout by
# tools/check-house-lint.sh and tools/ontology-score.sh. Local artifacts, never
# tracked source.
/house-lint-output/
/house-lint-report.md
/ontology-alignment/
/ontology-ratchet/
/ontology-ratchet.md

# A go build of app/csf/cmd at the root writes this binary; it is never source.
/cmd
# Python bytecode a test or script run writes beside its source; never source.
__pycache__/
*.pyc
# Git worktrees agent sessions create for isolated work; never source.
/.claude/worktrees/
