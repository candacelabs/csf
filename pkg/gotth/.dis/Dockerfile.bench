# The benchmark image, and the only image in this project that contains node.
#
# It derives from the library image so the Go, protoc and templ toolchains are
# identical on both sides of the comparison, and adds node and npm on top. The
# quarantine the requirements ask for is therefore structural: the comparison
# app under bench/ is the only thing that can be built here, and nothing in the
# library can acquire a node dependency without someone moving it into this
# file first.
#
# Build the library image first, then:
#
#     docker build -t dis-gotth-live-bench:latest \
#         -f candace/pkg/gotth/.dis/Dockerfile.bench candace/pkg/gotth/.dis
#
ARG BASE_IMAGE=dis-gotth-live:latest
FROM ${BASE_IMAGE}

LABEL dis.shell="/bin/bash"

# Node 24 "Krypton" is the active LTS line. Pinned to an exact patch release,
# with the checksum verified against the release manifest, because the
# benchmark's whole claim to fairness rests on both stacks being reproducible
# from the committed versions.
ARG NODE_VERSION=24.19.0
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "${arch}" in \
      amd64) node_arch='x64' ;; \
      arm64) node_arch='arm64' ;; \
      *) echo "unsupported architecture: ${arch}" >&2; exit 1 ;; \
    esac; \
    tarball="node-v${NODE_VERSION}-linux-${node_arch}.tar.gz"; \
    cd /tmp; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/${tarball}"; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt"; \
    grep " ${tarball}\$" SHASUMS256.txt | sha256sum -c -; \
    tar -xzf "${tarball}" -C /usr/local --strip-components=1 \
        --no-same-owner --exclude=CHANGELOG.md --exclude=LICENSE --exclude=README.md; \
    rm -f "${tarball}" SHASUMS256.txt; \
    node --version; \
    npm --version

# Chromium, from Debian's own security suite on this image's base.
#
# It is here rather than in the library image for the same reason node is: the
# library must be buildable and testable without a browser anywhere, and the
# absence is what makes that structural. What it buys is the evidence three
# criteria have no other way to get — the counter working in a real browser,
# event-to-paint rather than event-to-patch, and the runtime functioning under
# a strict Content-Security-Policy, which is a browser behaviour and cannot be
# asserted from Go.
#
# Unversioned deliberately: pinning a chromium patch release against a rolling
# security suite produces a Dockerfile that stops building, and the property
# under test is "a real browser", not "this browser". The version that produced
# a given measurement is recorded with the measurement.
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium \
    && rm -rf /var/lib/apt/lists/* \
    && chromium --version

# Chromium's sandbox needs kernel capabilities a container does not have by
# default. Harnesses here run it headless with --no-sandbox, which is
# acceptable because the only pages it loads are the ones this repository
# serves it.
ENV CHROME_BIN=/usr/bin/chromium

WORKDIR /workspace
