# The bench tree is the only place node exists in this repository (FR-74).
# Everything it produces is derived and stays out of git.
node_modules/
.next/
.next-*/
*.tsbuildinfo
.env*.local

# Generated: the seeded fixture bytes. The *generator* and the SHA-256 are
# committed; the ~10-100 MB of JSONL they produce is not. Regenerate with
# `npm run fixtures` and verify with `npm run fixtures:verify` (§2.5).
fixtures/*/ticks.jsonl

# Generated: the copy of harness/shim.js each app serves from public/.
# `npm run verify:shim` asserts the copies are byte-identical to the source.
apps/*/next/public/bench/shim.js

# NOT ignored, deliberately: apps/*/gotth/bench/ready.js. They are generated
# from harness/ready.js by scripts/sync-ready.mjs exactly as the shim copies
# are, and the symmetry stops here on purpose — `//go:embed bench/ready.js`
# resolves at COMPILE time, so ignoring them makes a clean checkout fail with
# "pattern bench/ready.js: no matching files found" in dis-gotth-live:latest,
# which has no node to regenerate them with. `npm run verify:ready` (or plain
# `sh scripts/verify-ready.sh`, for that node-free image) is what replaces the
# ignore. D-6; bench/README.md has the long form.

# Bundle-analyzer output is regenerated by `ANALYZE=true npm run build`;
# the committed audit artefact is audit/nextjs-pessimization-checklist.md.
analyze/
