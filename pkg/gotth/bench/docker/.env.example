# The measured topology's parameters (equivalence-spec §5.2, §5.7).
#
# Copy to docker/.env before a run. The file is not committed with values,
# because the cpuset assignment is a property of the HOST a run happened on and
# §6 requires it to reach the report through the run manifest — which the
# harness writes from `docker inspect`, not from this file. Two places to state
# the same fact is one place too many, and this is the one that can be stale.
#
# ---------------------------------------------------------------------------
# §5.2's FOUR DISJOINT CPUSETS
#
# "Four disjoint cpusets: server under test, TLS-terminating proxy, load
# generator / session driver, browser harness. Core assignments stated."
#
# Amendment A-1 raised the requirement from three to four, so the host must have
# enough cores to give the proxy its own without squeezing the SUT. The bench
# host taken by docs/OPERATOR-QUESTIONS.md Q-2 (`node-a`) has 32 logical CPUs,
# which is enough — but it is a SHARED host running a GPU streaming stack and a
# long tail of other projects, so these sets are a floor on isolation and not a
# guarantee of it. The manifest's `contended` flag is where that shows up in the
# data.
#
# The example split below is 8/2/8/8, leaving cores 26-31 for the host's own
# tenants. Disjoint is the requirement; these particular numbers are not.
#
# WHAT "DISJOINT" CAN AND CANNOT MEAN HERE. `node-a` is a virtual-machine
# guest, and its 32 CPUs present as 32 independent cores: every
# /sys/.../topology/thread_siblings_list is a single entry, and all 32 share one
# L3 domain. So the guest cannot pair a core with an SMT sibling or place a set
# inside one cache domain — logical disjointness is the whole of what these four
# sets can buy, and how the hypervisor lays these vCPUs onto the 9950X3D's
# physical cores is not visible from in here. Stated because "four disjoint
# cpusets" reads like an isolation guarantee and on a guest it is a floor. It is
# the same fact the manifest's `contended` flag carries, at a different layer.

BENCH_CPUSET_SUT=0-7
BENCH_CPUSET_PROXY=8-9
BENCH_CPUSET_DRIVER=10-17
BENCH_CPUSET_BROWSER=18-25

# ---------------------------------------------------------------------------
# The stack under test. One of these per run; the harness interleaves A/B/A/B
# at the run level (§5.2) so thermal and frequency drift is common-mode.
#
# THE UPSTREAM PAIR IS THE ONLY THING THAT MOVES WITH THE STACK, and the WS half
# is not the same on both. The Next.js side runs §5.4's `ws` variant as a second
# process in the same container on 3101; gotth-live has no sidecar — its
# WebSocket lives at the app's own mount path (/counter/live, /chat/live,
# /dashboard/live) on port 3000. So:
#
#   Next.js run   BENCH_SUT_IMAGE=gotth-live-bench/<app>-next:sse
#                 BENCH_UPSTREAM_HTTP=app:3000
#                 BENCH_UPSTREAM_WS=app:3101
#
#   gotth-live run  BENCH_SUT_IMAGE=gotth-live-bench/<app>-gotth:local
#                   BENCH_UPSTREAM_HTTP=app:3000
#                   BENCH_UPSTREAM_WS=app:3000
#
# That difference is an ENV VALUE, not a second proxy configuration. §5.2 makes
# one Caddyfile serve both sides and it does: `handle /ws*` never matches a
# gotth mount path, the mount path falls to the final `handle`, and Caddy
# hijacks a 101 into a bidirectional stream there exactly as it does under
# `@stream`. The manifest records which values were in force.

BENCH_SUT_IMAGE=gotth-live-bench/dashboard-gotth:local
BENCH_UPSTREAM_HTTP=app:3000
BENCH_UPSTREAM_WS=app:3000

# The origin the BROWSER sends. It is the PROXY's scheme, host and port — not
# the app's — because the browser only ever talks to the proxy. gotth-live's
# WebSocket Origin allowlist is derived from the listen address and is deny by
# default, so a value that disagrees with BENCH_PROXY_PORT below is a 403 on
# every upgrade. Keep the two in step; the app prints the allowlist it ended up
# with on its first line of output. Ignored by the Next.js image.
BENCH_ORIGIN=https://127.0.0.1:18443

# §5.4's live-data variant: sse (primary) | ws (secondary) | poll (D3/D4 only).
BENCH_VARIANT=sse

# ---------------------------------------------------------------------------
# Container constraints, identical on both sides (§5.2). memswap_limit is set
# equal to mem_limit in compose.yaml, which disables swap.

BENCH_SUT_MEM=4g
BENCH_PROXY_MEM=512m
BENCH_PIDS_LIMIT=4096
BENCH_NOFILE=1048576

# §3.6: "GC configuration is pinned and disclosed: GOGC and GOMEMLIMIT on the
# Go side; --max-old-space-size on the Node side, set equal to the container
# memory limit. Values recorded in the run manifest. Neither is tuned for the
# benchmark beyond its framework's documented production default."
BENCH_NODE_OPTIONS=--max-old-space-size=4096
BENCH_GOGC=100
BENCH_GOMEMLIMIT=4GiB

# ---------------------------------------------------------------------------
# 127.0.0.1 ephemeral ports only (§5.3). The proxy is the only container that
# publishes anything; :18444 is §3.7's proxy-saturation listener, which serves a
# static response with no upstream so saturating it measures the proxy alone.

BENCH_PROXY_PORT=18443
BENCH_PROXY_CEILING_PORT=18444

# ---------------------------------------------------------------------------
# §2.5's replay schedule. 100 ms is the spec's tick. The chat stress row (§2.3,
# 20 msg/s instead of 2) replays the SAME committed bytes at 10 ms; the value in
# force is recorded in the manifest.

BENCH_TICK_MS=100
BENCH_POLL_INTERVAL_MS=1000

# ---------------------------------------------------------------------------
# Q-7's gate: which co-tenant container counts as an active GPU streaming
# session. Comma-separated substrings, matched case-insensitively against every
# running container's NAME and its IMAGE; a match stops the run.
#
# WHICH container that is belongs to the deployment rather than to this library,
# which is why it is a parameter and not a literal in harness/host-state.mjs.
# The default below is what the harness matches when this is unset OR blank —
# an empty match list would be a Q-7 check that blocks nothing, and a gate that
# cannot fire is the failure the whole §5.2 apparatus exists to refuse, so a
# blank value falls back rather than opening the gate.
#
# Waiting is the only permitted mitigation. Nothing in this tree stops, restarts
# or reconfigures a co-tenant container to make a run cleaner.

BENCH_GPU_SESSION_MATCH=steam,selkies
