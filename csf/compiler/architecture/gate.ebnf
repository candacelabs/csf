(* Code generated by csfc from csf/compiler/language/ebnf_codegen.ml; DO NOT EDIT. *)
gate        = "gate", identifier, string, string, edge_clause, side_clause,
              { relation }, { rule }, "{", { fact }, "}" ;
edge_clause = "edge", identifier, identifier ;
side_clause = "side", side ;
side        = "harness" | "harness_environment" | "environment" | "provider" | "model" ;
(* A declared relation or rule: its identifier and its one-line definition. *)
relation    = "relation", identifier, string ;
rule        = "rule", identifier, string ;
(* A fact names its relation, then its arguments, then ends a line. word W
   declares a gh noun; verb V declares a gh verb; replacement W V T maps the
   noun and verb to one CSF tool. *)
fact        = identifier, identifier, ";"
            | identifier, identifier, identifier, identifier, ";" ;
