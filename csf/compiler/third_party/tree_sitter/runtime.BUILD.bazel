    name = "stubs",
    srcs = ["lib/tree_sitter_runtime.c", "lib/tree_sitter_stubs.c"],
    hdrs = glob(["include/**/*.h", "vendor/tree-sitter/**/*.h"]),
    textual_hdrs = glob(["vendor/tree-sitter/**/*.c"]),
    includes = ["include", "vendor/tree-sitter"],
    copts = ["-std=c11", "-D_DEFAULT_SOURCE"],
    linkopts = ["-ldl", "-lpthread"],
