load("@rules_ocaml//build:rules.bzl", "ocaml_module")

package(default_visibility = ["//visibility:public"])

exports_files([
    "runtime.BUILD.bazel",
    "grammar.BUILD.bazel",
    "python_grammar.BUILD.bazel",
])

# Upstream source: its warnings are not ours to fix, so the repository-wide
# -warn-error does not apply to it.
UPSTREAM_OPTS = ["-w", "-a"]

ocaml_module(
    name = "Tree_sitter",
    opts = UPSTREAM_OPTS,
    cc_deps = ["@tree_sitter_ocaml_source//:stubs"],
    sig = "@tree_sitter_ocaml_source//:lib/tree_sitter.mli",
    struct = "@tree_sitter_ocaml_source//:lib/tree_sitter.ml",
)

# Native consumers share the same parser revision without importing OCaml stubs.
alias(
    name = "raw_runtime",
    actual = "@tree_sitter_ocaml_source//:raw_runtime",
)

alias(
    name = "go_parser",
    actual = "@tree_sitter_go//:parser",
)
