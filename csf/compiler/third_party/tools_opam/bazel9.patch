+# These are OPAM package names and versions. Findlib library names are a
+# separate namespace: one installed package may provide several libraries.
+def _installed_versions(rctx, opam, root, switch):
+    listed = rctx.execute([str(opam), "list", "--root", str(root),
+                           "--switch", switch, "--installed",
+                           "--columns=name,version", "--short"])
+    if listed.return_code != 0:
+        fail("Cannot read resolved opam dependencies: " + listed.stderr)
+    resolved = {}
+    for line in listed.stdout.splitlines():
+        fields = [field for field in line.replace("\t", " ").split(" ") if field]
+        if len(fields) == 2:
+            resolved[fields[0]] = fields[1]
+    return resolved
+
+# Initializing repository metadata has its own cold preparation budget. It does
+# not install or claim a compiler. The compiler repository consumes this marker.
+def _opam_repository_impl(rctx):
+    context_root = rctx.getenv("CSF_OCAML_TOOLCHAIN_ROOT") or str(rctx.path("opam"))
+    opam, root = init_xdg_toolchain(
+        rctx, rctx.attr.opam_version, rctx.attr.debug,
+        rctx.attr.opam_verbosity, rctx.attr.verbosity, context_root,
+    )
+    version = rctx.execute([str(opam), "--version"])
+    if version.return_code != 0 or version.stdout.strip() != rctx.attr.opam_version:
+        fail("Prepared opam differs from the requested version")
+    available = rctx.execute([str(opam), "show", "ocaml-base-compiler." + rctx.attr.ocaml_version,
+                              "--root", str(root), "--field=version"])
+    if available.return_code != 0 or available.stdout.strip() != rctx.attr.ocaml_version:
+        fail("The initialized repository cannot resolve the requested compiler")
+    rctx.file("repository.json", json.encode({"context_root": context_root}))
+    rctx.file("BUILD.bazel", 'exports_files(["repository.json"])\n')
+
+opam_repository = repository_rule(
+    implementation = _opam_repository_impl,
+    attrs = {
+        "opam_version": attr.string(mandatory = True),
+        "ocaml_version": attr.string(mandatory = True),
+        "debug": attr.int(),
+        "opam_verbosity": attr.int(),
+        "verbosity": attr.int(),
+    },
+)
+
+# A successful bootstrap is an intermediate source build, never an installed
+# compiler. Only the following opam compiler repository may claim installation.
+def _opam_bytecode_impl(rctx):
+    repository = json.decode(rctx.read(rctx.attr.repository))
+    prepare_xdg_bytecode(
+        rctx, rctx.attr.opam_version, rctx.attr.ocaml_version,
+        rctx.attr.debug, rctx.attr.opam_verbosity, rctx.attr.verbosity,
+        repository["context_root"],
+    )
+    rctx.file("bytecode.json", json.encode(repository))
+    rctx.file("BUILD.bazel", 'exports_files(["bytecode.json"])\n')
+
+opam_bytecode = repository_rule(
+    implementation = _opam_bytecode_impl,
+    attrs = {
+        "repository": attr.label(mandatory = True, allow_single_file = True),
+        "opam_version": attr.string(mandatory = True),
+        "ocaml_version": attr.string(mandatory = True),
+        "debug": attr.int(),
+        "opam_verbosity": attr.int(),
+        "verbosity": attr.int(),
+    },
+)
+
+# The compiler-only preparation target never claims a complete dependency graph.
+def _opam_compiler_impl(rctx):
+    repository = json.decode(rctx.read(rctx.attr.repository))
+    context_root = repository["context_root"]
+    (opam, root, _sdklib, switch, _version, _libraries) = config_xdg_toolchain(
+        rctx, rctx.attr.opam_version, rctx.attr.ocaml_version, [], {},
+        rctx.attr.debug, rctx.attr.opam_verbosity, rctx.attr.verbosity,
+        context_root = context_root,
+    )
+    resolved = _installed_versions(rctx, opam, root, switch)
+    if not rctx.attr.update_lock:
+        for package, version in resolved.items():
+            if rctx.attr.locked_versions.get(package) != version:
+                fail("Installed compiler preparation package differs from lock: " + package)
+    for executable in ["ocamlc", "ocamlopt"]:
+        checked = rctx.execute([str(root) + "/" + switch + "/bin/" + executable, "-version"])
+        if checked.return_code != 0 or checked.stdout.strip() != rctx.attr.ocaml_version:
+            fail("Prepared OCaml compiler differs from the requested version: " + executable)
+    rctx.file("compiler.json", json.encode({"context_root": context_root, "packages": resolved}))
+    rctx.file("BUILD.bazel", 'exports_files(["compiler.json"])\n')
+
+opam_compiler = repository_rule(
+    implementation = _opam_compiler_impl,
+    attrs = {
+        "repository": attr.label(mandatory = True, allow_single_file = True),
+        "opam_version": attr.string(mandatory = True),
+        "ocaml_version": attr.string(mandatory = True),
+        "locked_versions": attr.string_dict(mandatory = True),
+        "update_lock": attr.bool(),
+        "debug": attr.int(),
+        "opam_verbosity": attr.int(),
+        "verbosity": attr.int(),
+    },
+)
+
+# A repository dependency owns executable/toolchain installation. Extension
+# lockfile replay only declares this repository; fetching any package still
+# materializes its complete bootstrap dependency first.
+def _opam_packages_impl(rctx):
+    compiler = json.decode(rctx.read(rctx.attr.compiler))
+    (opam, root, sdklib, switch, ocaml_version, libraries) = config_xdg_toolchain(
+        rctx, rctx.attr.opam_version, rctx.attr.ocaml_version,
+        rctx.attr.packages.keys(), rctx.attr.packages,
+        rctx.attr.debug, rctx.attr.opam_verbosity, rctx.attr.verbosity,
+        context_root = compiler["context_root"],
+    )
+    resolved = _installed_versions(rctx, opam, root, switch)
+    libraries = sorted(libraries)
+    if not rctx.attr.update_lock and (
+        resolved != rctx.attr.locked_versions or libraries != rctx.attr.locked_libraries
+    ):
+        fail("Resolved opam packages or findlib libraries differ from lock; run the explicit lock update command")
+    graph = {"schema_version": 1, "packages": resolved, "libraries": libraries}
+    rctx.file("opam.lock.json", json.encode_indent(graph) + "\n")
+    rctx.file("packages.json", json.encode({
+        "opam": str(opam), "root": str(root), "sdklib": str(sdklib),
+        "switch": switch,
+        "graph": graph,
+    }))
+    rctx.file("BUILD.bazel", 'exports_files(["packages.json", "opam.lock.json"])\n')
+
+opam_packages = repository_rule(
+    implementation = _opam_packages_impl,
+    attrs = {
+        "compiler": attr.label(mandatory = True, allow_single_file = True),
+        "opam_version": attr.string(mandatory = True),
+        "ocaml_version": attr.string(mandatory = True),
+        "packages": attr.string_dict(mandatory = True),
+        "locked_versions": attr.string_dict(mandatory = True),
+        "locked_libraries": attr.string_list(mandatory = True),
+        "update_lock": attr.bool(),
+        "debug": attr.int(),
+        "opam_verbosity": attr.int(),
+        "verbosity": attr.int(),
+    },
+)
+
+# Native Bazel metadata needs the configuration helper; installing the package
+# graph does not. Keeping these dependencies separate makes cold preparation
+# bounded without changing the full graph validation consumed by every build.
+def _opam_bootstrap_impl(rctx):
+    packages = json.decode(rctx.read(rctx.attr.packages))
+    config_tool = _build_config_tool(rctx, "xdg", rctx.attr.debug, rctx.attr.verbosity)
+    copied = rctx.execute(["cp", str(config_tool), "config-tool"])
+    if copied.return_code != 0:
+        fail("Cannot retain opam configuration tool: " + copied.stderr)
+    runfiles = rctx.execute(["cp", "-RL", str(config_tool) + ".runfiles", "config-tool.runfiles"])
+    if runfiles.return_code != 0:
+        fail("Cannot retain opam configuration templates: " + runfiles.stderr)
+    packages["config_tool"] = str(rctx.path("config-tool"))
+    rctx.file("bootstrap.json", json.encode(packages))
+    rctx.file("BUILD.bazel", 'exports_files(["bootstrap.json"])\n')
+
+opam_bootstrap = repository_rule(
+    implementation = _opam_bootstrap_impl,
+    attrs = {
+        "packages": attr.label(mandatory = True, allow_single_file = True),
+        "debug": attr.int(),
+        "verbosity": attr.int(),
+    },
+)
+
+def _declare_locked_xdg(mctx, opam_version, ocaml_version, package_versions,
+                        locked_versions, locked_libraries, update_lock, direct_deps, dev_deps,
+                        obazl_pfx, debug, opam_verbosity, verbosity):
+    # Keep this chain explicit in repository labels:
+    # repository -> bytecode -> compiler -> packages -> bootstrap -> imports.
+    # Each preparation job can stop at one marker. A normal library build reads
+    # bootstrap.json, which requires every preceding stage even when Bazel
+    # restores the module extension's declarations from MODULE.bazel.lock.
+    opam_repository(
+        name = "opam.repository", opam_version = opam_version,
+        ocaml_version = ocaml_version,
+        debug = debug, opam_verbosity = opam_verbosity, verbosity = verbosity,
+    )
+    opam_bytecode(
+        name = "opam.bytecode", repository = "@opam.repository//:repository.json",
+        opam_version = opam_version, ocaml_version = ocaml_version,
+        debug = debug, opam_verbosity = opam_verbosity, verbosity = verbosity,
+    )
+    opam_compiler(
+        name = "opam.compiler", opam_version = opam_version,
+        repository = "@opam.bytecode//:bytecode.json",
+        ocaml_version = ocaml_version, locked_versions = locked_versions,
+        update_lock = update_lock,
+        debug = debug, opam_verbosity = opam_verbosity, verbosity = verbosity,
+    )
+    opam_packages(
+        name = "opam.packages", opam_version = opam_version,
+        compiler = "@opam.compiler//:compiler.json",
+        ocaml_version = ocaml_version, packages = package_versions,
+        locked_versions = locked_versions, locked_libraries = locked_libraries,
+        update_lock = update_lock,
+        debug = debug, opam_verbosity = opam_verbosity, verbosity = verbosity,
+    )
+    opam_bootstrap(
+        name = "opam.bootstrap", packages = "@opam.packages//:packages.json",
+        debug = debug, verbosity = verbosity,
+    )
+    opam_lock(name = "opam.lock", source = "@opam.packages//:opam.lock.json")
+    packages = {library: locked_versions.get(library, "") for library in locked_libraries
+                if library not in OBAZL_PKGS}
+    packages.update({"ocamlsdk": ocaml_version, "stublibs": ocaml_version})
+    for pkg, version in packages.items():
+        opam_dep(
+            name = obazl_pfx + pkg, pkg_version = version,
+            bootstrap = "@opam.bootstrap//:bootstrap.json",
+            ocaml_version = ocaml_version, obazl_pfx = obazl_pfx,
+            debug = debug, opam_verbosity = opam_verbosity, verbosity = verbosity,
+        )
+    root_deps = ["opam.ocamlsdk", "opam.lock", "opam.compiler", "opam.repository", "opam.bytecode"] + [
+        obazl_pfx + pkg for pkg in direct_deps if pkg not in OBAZL_PKGS
+    ]
+    root_dev_deps = [
+        obazl_pfx + pkg for pkg in dev_deps if pkg not in OBAZL_PKGS
+    ]
+    if mctx.root_module_has_non_dev_dependency:
+        return mctx.extension_metadata(
+            root_module_direct_deps = root_deps,
+            root_module_direct_dev_deps = root_dev_deps,
+        )
+    return mctx.extension_metadata(
+        root_module_direct_deps = [],
+        root_module_direct_dev_deps = root_deps + root_dev_deps,
+    )
+
