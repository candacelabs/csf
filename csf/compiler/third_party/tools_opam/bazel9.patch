+# A repository dependency owns executable/toolchain installation. Extension
+# lockfile replay only declares this repository; fetching any package still
+# materializes its complete bootstrap dependency first.
+def _opam_bootstrap_impl(rctx):
+    config_tool = _build_config_tool(rctx, "xdg", rctx.attr.debug, rctx.attr.verbosity)
+    copied = rctx.execute(["cp", str(config_tool), "config-tool"])
+    if copied.return_code != 0:
+        fail("Cannot retain opam configuration tool: " + copied.stderr)
+    runfiles = rctx.execute(["cp", "-RL", str(config_tool) + ".runfiles", "config-tool.runfiles"])
+    if runfiles.return_code != 0:
+        fail("Cannot retain opam configuration templates: " + runfiles.stderr)
+    (opam, root, sdklib, switch, ocaml_version, libraries) = config_xdg_toolchain(
+        rctx, rctx.attr.opam_version, rctx.attr.ocaml_version,
+        rctx.attr.packages.keys(), rctx.attr.packages,
+        rctx.attr.debug, rctx.attr.opam_verbosity, rctx.attr.verbosity,
+        context_root = str(rctx.path("opam")),
+    )
+    listed = rctx.execute([str(opam), "list", "--root", str(root),
+                           "--switch", switch, "--installed",
+                           "--columns=name,version", "--short"])
+    if listed.return_code != 0:
+        fail("Cannot read resolved opam dependencies: " + listed.stderr)
+    resolved = {}
+    for line in listed.stdout.splitlines():
+        fields = [field for field in line.replace("\t", " ").split(" ") if field]
+        if len(fields) == 2:
+            resolved[fields[0]] = fields[1]
+    libraries = sorted(libraries)
+    if not rctx.attr.update_lock and (
+        resolved != rctx.attr.locked_versions or libraries != rctx.attr.locked_libraries
+    ):
+        fail("Resolved opam packages or findlib libraries differ from lock; run the explicit lock update command")
+    graph = {"schema_version": 1, "packages": resolved, "libraries": libraries}
+    rctx.file("opam.lock.json", json.encode_indent(graph) + "\n")
+    rctx.file("bootstrap.json", json.encode({
+        "opam": str(opam), "root": str(root), "sdklib": str(sdklib),
+        "switch": switch, "config_tool": str(rctx.path("config-tool")),
+        "graph": graph,
+    }))
+    rctx.file("BUILD.bazel", 'exports_files(["bootstrap.json", "opam.lock.json"])\n')
+
+opam_bootstrap = repository_rule(
+    implementation = _opam_bootstrap_impl,
+    attrs = {
+        "opam_version": attr.string(mandatory = True),
+        "ocaml_version": attr.string(mandatory = True),
+        "packages": attr.string_dict(mandatory = True),
+        "locked_versions": attr.string_dict(mandatory = True),
+        "locked_libraries": attr.string_list(mandatory = True),
+        "update_lock": attr.bool(),
+        "debug": attr.int(),
+        "opam_verbosity": attr.int(),
+        "verbosity": attr.int(),
+    },
+)
+
+def _declare_locked_xdg(mctx, opam_version, ocaml_version, package_versions,
+                        locked_versions, locked_libraries, update_lock, direct_deps, dev_deps,
+                        obazl_pfx, debug, opam_verbosity, verbosity):
+    opam_bootstrap(
+        name = "opam.bootstrap", opam_version = opam_version,
+        ocaml_version = ocaml_version, packages = package_versions,
+        locked_versions = locked_versions, locked_libraries = locked_libraries,
+        update_lock = update_lock,
+        debug = debug, opam_verbosity = opam_verbosity, verbosity = verbosity,
+    )
+    opam_lock(name = "opam.lock", source = "@opam.bootstrap//:opam.lock.json")
+    packages = {library: locked_versions.get(library, "") for library in locked_libraries
+                if library not in OBAZL_PKGS}
+    packages.update({"ocamlsdk": ocaml_version, "stublibs": ocaml_version})
+    for pkg, version in packages.items():
+        opam_dep(
+            name = obazl_pfx + pkg, pkg_version = version,
+            bootstrap = "@opam.bootstrap//:bootstrap.json",
+            ocaml_version = ocaml_version, obazl_pfx = obazl_pfx,
+            debug = debug, opam_verbosity = opam_verbosity, verbosity = verbosity,
+        )
+    root_deps = ["opam.ocamlsdk", "opam.lock"] + [
+        obazl_pfx + pkg for pkg in direct_deps if pkg not in OBAZL_PKGS
+    ]
+    root_dev_deps = [
+        obazl_pfx + pkg for pkg in dev_deps if pkg not in OBAZL_PKGS
+    ]
+    if mctx.root_module_has_non_dev_dependency:
+        return mctx.extension_metadata(
+            root_module_direct_deps = root_deps,
+            root_module_direct_dev_deps = root_dev_deps,
+        )
+    return mctx.extension_metadata(
+        root_module_direct_deps = [],
+        root_module_direct_dev_deps = root_deps + root_dev_deps,
+    )
+
