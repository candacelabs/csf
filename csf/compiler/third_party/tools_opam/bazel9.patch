+#!/usr/bin/env python3
+"""Preserve identical bootstrap inputs after opam extraction and configuration."""
+# This helper is added to the upstream dependency by bazel9.patch. It runs in
+# the OCaml source directory, not in CSF's source tree. Its three uses are:
+#   --record: retain a successfully built bootstrap's regular-file identities;
+#   --verify: reject changed/missing/extra files or modes after cache restore;
+#   COMMAND: run the real build command, handling timestamps only for configure.
+# It never skips configuration, marks a compiler installed, or accepts a failed
+# command. The repository rule removes the temporary OPAM hook after the build.
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+RECEIPT = ".csf-bootstrap-mtimes.json"
+
+
+def fingerprint(path):
+    digest = hashlib.sha256()
+    with path.open("rb") as source:
+        for block in iter(lambda: source.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def snapshot():
+    # Ignore symlinks and the receipt itself. Record relative paths so the
+    # same validated tree can be restored at another worker's filesystem path.
+    before = {}
+    for path in Path.cwd().rglob("*"):
+        if path.is_file() and not path.is_symlink() and path.name != RECEIPT:
+            status = path.stat()
+            before[str(path.relative_to(Path.cwd()))] = {
+                "mode": status.st_mode, "mtime_ns": status.st_mtime_ns,
+                "sha256": fingerprint(path),
+            }
+    return before
+
+
+def main():
+    command = sys.argv[1:]
+    if command == ["--record"]:
+        Path(RECEIPT).write_text(json.dumps(snapshot()))
+        return 0
+    if command == ["--verify"]:
+        expected = json.loads(Path(RECEIPT).read_text())
+        actual = snapshot()
+        # Copying a cache may change mtimes without changing the build inputs.
+        # Identity therefore checks contents and modes; configure restores a
+        # saved mtime only after checking that same identity again.
+        valid = expected.keys() == actual.keys() and all(
+            actual[name]["mode"] == saved["mode"] and actual[name]["sha256"] == saved["sha256"]
+            for name, saved in expected.items()
+        )
+        return 0 if valid else 1
+    if not command:
+        return 2
+    if Path(command[0]).name != "configure":
+        os.execvp(command[0], command)
+    # Opam may copy byte-identical source files before invoking configure. The
+    # earlier successful bootstrap owns the timestamps, not this new extraction.
+    before = json.loads(Path(RECEIPT).read_text()) if Path(RECEIPT).exists() else snapshot()
+    # Always execute upstream configure and propagate its exit status. Failed
+    # configuration leaves its output untouched for diagnostics and a retry.
+    result = subprocess.run(command)
+    if result.returncode == 0:
+        newest = max((saved["mtime_ns"] for saved in before.values()), default=0)
+        for name, saved in before.items():
+            path = Path(name)
+            if path.is_absolute() or ".." in path.parts:
+                raise ValueError("bootstrap receipt path escapes the build directory")
+            if path.is_file() and not path.is_symlink():
+                status = path.stat()
+                identical = status.st_mode == saved["mode"] and fingerprint(path) == saved["sha256"]
+                # Changed extracted inputs may carry old archive timestamps.
+                # Make them newer than every prepared output so make rebuilds.
+                stamp = saved["mtime_ns"] if identical else max(time.time_ns(), newest + 1, status.st_mtime_ns)
+                os.utime(path, ns=(status.st_atime_ns, stamp))
+    return result.returncode
+
+
+if __name__ == "__main__":
+    sys.exit(main())
