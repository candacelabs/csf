+# The lock is a declared Bazel input/output, not state discovered in a user's
+# global switch. Locked builds publish the graph validated by opam.packages;
+# the unlocked upstream path can still publish its freshly resolved content.
+def _opam_lock_impl(rctx):
+    if rctx.attr.source:
+        rctx.symlink(rctx.path(rctx.attr.source), "opam.lock.json")
+    else:
+        rctx.file("opam.lock.json", rctx.attr.content)
+    rctx.file("BUILD.bazel", 'exports_files(["opam.lock.json"])\n')
+
+opam_lock = repository_rule(
+    implementation = _opam_lock_impl,
+    attrs = {"content": attr.string(), "source": attr.label(allow_single_file = True)},
