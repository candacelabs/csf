load("@rules_ocaml//build:rules.bzl", "ocaml_module")

package(default_visibility = ["//visibility:public"])

exports_files(["source.BUILD.bazel"])

# Upstream source: its warnings are not ours to fix, so the repository-wide
# -warn-error does not apply to it.
UPSTREAM_OPTS = ["-w", "-a"]

ocaml_module(
    name = "AST",
    opts = UPSTREAM_OPTS,
    struct = "@datalog_ocaml_source//:src/top_down/AST.ml",
)

ocaml_module(
    name = "Parser",
    opts = UPSTREAM_OPTS,
    sig = "@datalog_ocaml_source//:Parser.mli",
    struct = "@datalog_ocaml_source//:Parser.ml",
    deps = [":AST"],
)

ocaml_module(
    name = "Lexer",
    opts = UPSTREAM_OPTS,
    struct = "@datalog_ocaml_source//:Lexer.ml",
    deps = [":Parser"],
)

ocaml_module(
    name = "Datalog_top_down",
    opts = UPSTREAM_OPTS,
    sig = "@datalog_ocaml_source//:src/top_down/Datalog_top_down.mli",
    struct = "@datalog_ocaml_source//:src/top_down/Datalog_top_down.ml",
    deps = [
        ":AST",
        ":Lexer",
        ":Parser",
    ],
)
