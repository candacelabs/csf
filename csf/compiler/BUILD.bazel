package(default_visibility = ["//visibility:public"])

exports_files([
    "opam.lock.json",
    "verification/question_tree.csf",
    "verification/CSFCVerifier.lean",
    "verification/question_cli_layer.txt",
    "verification/question_directory.txt",
    "verification/question_jev_prompt.txt",
    "verification/question_kind_enum.txt",
])

# Stable command path for public compiler consumers.
genrule(
    name = "csfc",
    srcs = ["//csf/compiler/architecture:csfc"],
    outs = ["bin/csfc"],
    cmd = "cp $(location //csf/compiler/architecture:csfc) $@",
    executable = True,
)
