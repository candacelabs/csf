load("@rules_ocaml//build:rules.bzl", "ocaml_binary", "ocaml_module", "ocaml_test")

package(default_visibility = ["//visibility:public"])

ocaml_module(
    name = "Checker",
    struct = "checker.ml",
    deps = [
        "//csf/compiler/source_support:Go_source",
        "//csf/compiler/third_party/tree_sitter:Tree_sitter",
        "@opam.ocamlsdk//unix/lib",
    ],
)

ocaml_module(
    name = "Main",
    struct = "main.ml",
    deps = [
        ":Checker",
        "@opam.ocamlsdk//unix/lib",
    ],
)

ocaml_binary(
    name = "check",
    main = ":Main",
)

ocaml_module(
    name = "Checker_test",
    struct = "checker_test.ml",
    deps = [
        ":Checker",
        "@opam.ocamlsdk//unix/lib",
    ],
)

ocaml_test(
    name = "checker_test",
    size = "small",
    main = ":Checker_test",
)

# Reviewed documentation inputs, consumed through Bazel dependency edges.
filegroup(
    name = "docsite_sources",
    srcs = [
        "README.md",
    ],
    visibility = ["//visibility:public"],
)
