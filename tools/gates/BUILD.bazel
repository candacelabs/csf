load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "gates_test",
    srcs = [
        "gates_suite_test.go",
        "house_lint_ratchet_test.go",
        "scripts_test.go",
        "workflow_test.go",
    ],
    # manual: the specs read the gate workflows under .github/ and check that
    # one representative file per score input exists across the tree, which
    # Bazel's per-package inputs cannot present. `go test ./tools/gates` in
    # the golang container is this suite's authority.
    tags = ["manual"],  # keep
    deps = [
        "//io/ipc/proc",
        "@com_github_onsi_ginkgo_v2//:ginkgo",
        "@com_github_onsi_gomega//:gomega",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)
