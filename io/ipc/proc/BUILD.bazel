load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "proc",
    srcs = [
        "group_other.go",
        "group_unix.go",
        "launcher.go",
        "memory.go",
        "process.go",
        "psi.go",
        "psi_linux.go",
        "psi_other.go",
    ],
    importpath = "github.com/candacelabs/csf/io/ipc/proc",
    visibility = ["//visibility:public"],
    deps = [
        "//io/kernel/fs",
        "//pkg/boundedbuffer",
        "//pkg/boundedbuffer/v1:boundedbuffer",
        "//runtime/config",
        "@com_github_creack_pty//:pty",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "proc_test",
    srcs = [
        "launcher_test.go",
        "launcher_unit_test.go",
        "memory_test.go",
        "proc_suite_test.go",
        "psi_test.go",
    ],
    embed = [":proc"],
    deps = [
        "//io/ipc/proc/mocks",
        "@com_github_onsi_ginkgo_v2//:ginkgo",
        "@com_github_onsi_gomega//:gomega",
        "@org_uber_go_mock//gomock",
    ] + select({
        "@rules_go//go/platform:android": [
            "//pkg/eventually",
            "@org_uber_go_goleak//:goleak",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/eventually",
            "@org_uber_go_goleak//:goleak",
        ],
        "//conditions:default": [],
    }),
)
