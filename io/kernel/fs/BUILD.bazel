load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "fs",
    srcs = [
        "files.go",
        "watch.go",
    ],
    importpath = "github.com/candacelabs/csf/io/kernel/fs",
    visibility = ["//visibility:public"],
    deps = ["@com_github_fsnotify_fsnotify//:fsnotify"],
