        "files_internal_test.go",
        "files_test.go",
        "fs_suite_test.go",
        "watch_test.go",
    ],
    embed = [":fs"],
    deps = [
        "@com_github_onsi_ginkgo_v2//:ginkgo",
        "@com_github_onsi_gomega//:gomega",
    ],
